---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';
import { currentNavigation, navigation } from '../lib/navigation';
---

<div class="blog-header">
  <div class="blog-title"><SiteTitle /></div>
  <nav class="header-links" aria-label="Điều hướng chính">
    {navigation.map(({ label, href }) => <a href={href} aria-current={currentNavigation(href, Astro.url.pathname)}>{label}</a>)}
  </nav>
  <div class="blog-search"><Search /></div>
  <div class="blog-controls"><SocialIcons /><ThemeSelect /></div>
</div>

<style>
  .blog-header { display: flex; align-items: center; gap: 1rem; height: 100%; }
  .blog-title { min-width: 0; margin-inline-end: auto; }
  .header-links { display: none; }
  .blog-controls { display: none; }
  @media (min-width: 50rem) {
    .blog-controls { display: flex; align-items: center; gap: .75rem; }
  }
  @media (min-width: 72rem) {
    .header-links { display: flex; align-items: center; gap: 1.5rem; }
    .header-links a { display: inline-flex; align-items: center; min-height: 44px; border-bottom: 2px solid transparent; color: var(--sl-color-gray-2); font-size: .875rem; text-decoration: none; white-space: nowrap; }
    .header-links a[aria-current] { color: var(--sl-color-accent-high); border-bottom-color: currentColor; }
  }
  @media (hover: hover) {
    .header-links a:hover { color: var(--sl-color-accent-high); text-decoration: underline; text-underline-offset: .3em; }
  }
</style>
