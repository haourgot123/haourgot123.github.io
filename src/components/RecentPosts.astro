---
const posts = Astro.locals.starlightBlog.posts.slice(0, 6);
const dateFormat = new Intl.DateTimeFormat('vi', { dateStyle: 'long', timeZone: 'Asia/Ho_Chi_Minh' });
---

<div class="post-list">
  {posts.length === 0 && <p>Chưa có bài viết được đăng.</p>}
  {posts.map((post) => (
    <article>
      <p class="post-meta"><time datetime={post.createdAt.toISOString()}>{dateFormat.format(post.createdAt)}</time><span aria-hidden="true"> · </span>{post.metrics.readingTime.minutes} phút đọc</p>
      <h3><a href={post.href}>{post.title}</a></h3>
      <p>{post.entry.data.description}</p>
      <ul class="post-tags" aria-label="Chủ đề">
        {post.tags.map((tag) => <li><a href={tag.href}>#{tag.label}</a></li>)}
      </ul>
    </article>
  ))}
</div>

<style>
  .post-list { display: grid; gap: 1.5rem; }
  article { padding-block: .5rem 1.5rem; border-bottom: 1px solid var(--sl-color-hairline-light); }
  .post-meta { color: var(--sl-color-gray-2); font-size: .875rem; margin: 0; }
  h3 { margin-block: .5rem .75rem; font-size: 1.35rem; }
  h3 a { color: var(--sl-color-accent-high); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin-block: .5rem 1rem; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 1rem; list-style: none; padding: 0; margin: 0; font-size: .875rem; }
  .post-tags li { margin: 0; }
  .post-tags a { text-decoration: none; }
</style>
